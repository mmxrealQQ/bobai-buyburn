/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://bsc-dataseed.binance.org https://api.binance.com https://api.geckoterminal.com https://api.gopluslabs.io https://api.dexscreener.com https://bsc.publicnode.com https://bsc-rpc.publicnode.com https://bsc-dataseed1.defibit.io https://bsc-mainnet.public.blastapi.io https://1rpc.io https://logs.brainonbnb.com https://aerffjhdsbxpvuulkryr.supabase.co; font-src 'self' data:; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-XSS-Protection: 1; mode=block

# HTML pages: immer frisch, aber NICHT no-store.
# max-age=0 + must-revalidate heisst: vor jeder Nutzung rueckfragen, also
# genauso aktuell wie no-store. Der Unterschied ist, was der Browser darf:
# no-store verbietet das Ablegen komplett und schaltet damit auch den
# Back-/Forward-Cache ab. Auf dem Handy hiess das: zurueck, App-Wechsel oder
# Bildschirm-aus = jedes Mal kompletter Neuaufbau mit weissem Schirm.
# Die Live-Zahlen holt die Seite ohnehin per JS, das HTML-Geruest darf also
# aus dem Speicher wiederverwendet werden.
# Asset files (CSS/JS/images) are versioned via ?v= params and can be cached.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/worldcup/app/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# Top-level clean page URLs (CF strips .html). Explicit per page — a /:page
# placeholder would also match top-level assets (logo.png etc.) and kill their caching.
/whitepaper
  Cache-Control: public, max-age=0, must-revalidate

/listing
  Cache-Control: public, max-age=0, must-revalidate

/scanner
  Cache-Control: public, max-age=0, must-revalidate

# Clean page URLs (CF strips .html → e.g. /worldcup/app/leaderboard). The
# :page placeholder matches a SINGLE segment, so it covers every app page but
# NOT the deeper /worldcup/app/assets/* files (those stay cacheable via ?v=).
# Without this, clean URLs fell through to default caching → stale on mobile.
/worldcup/app/:page
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# brainScreener: clean URLs frisch halten, Assets cachen
/brainscreener/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

/brainscreener/:page
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

/brainscreener/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

/brainscreener/assets/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/brainscreener/assets/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# app.js traegt den kompletten Seiten-Code und ist ueber ?v= versioniert —
# darf also lange liegen bleiben. Genau das macht das Aktualisieren auf dem
# Handy schnell: nur noch das HTML-Geruest kommt neu, die 27 KB Code nicht.
# Bei inhaltlichen Aenderungen die ?v= in index.html hochzaehlen.
/app.js
  Cache-Control: public, max-age=604800, must-revalidate

# Same for the stylesheet. It used to be an inline <style> block and made up
# half the document — 57 KB that had to cross the wire on every refresh, because
# Cloudflare Pages serves HTML without a fingerprint and can never answer "not
# modified". As its own file with ?v= it lives in the device cache.
# When editing the CSS, bump the ?v= in index.html.
/styles.css
  Cache-Control: public, max-age=604800, must-revalidate

# The typefaces. Content-addressed by name rather than by ?v=: a different font
# is a different file, so these may be cached for a year and never revalidated.
# That is the whole point of serving them here — from the second visit there is
# no request at all, and therefore nothing left to flicker.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The @font-face rules themselves do change, so they keep the ?v= treatment.
/fonts.css
  Cache-Control: public, max-age=604800, must-revalidate

# The code library. Rebuilt only when the source changes, so an hour of cache
# costs nothing and spares the origin a 500 KB text file per curious visitor.
# must-revalidate keeps a rebuild from staying hidden behind a stale copy.
/code/*
  Cache-Control: public, max-age=3600, must-revalidate
  X-Content-Type-Options: nosniff

# Scanner page code, versioned via ?v= in scanner.html like app.js.
/scanner.js
  Cache-Control: public, max-age=604800, must-revalidate

/scanner-chain.js
  Cache-Control: public, max-age=604800, must-revalidate
