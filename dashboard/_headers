/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; connect-src 'self' https://bsc-dataseed.binance.org https://api.binance.com https://api.geckoterminal.com https://raw.githubusercontent.com https://aerffjhdsbxpvuulkryr.supabase.co; font-src 'self' data: https://fonts.gstatic.com; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-XSS-Protection: 1; mode=block

# HTML pages: never cache — auth/login pages and dynamic content must always be fresh.
# Asset files (CSS/JS/images) are versioned via ?v= params and can be cached.
/*.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

/worldcup/app/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# Top-level clean page URLs (CF strips .html). Explicit per page — a /:page
# placeholder would also match top-level assets (logo.png etc.) and kill their caching.
/whitepaper
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

/listing
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# Clean page URLs (CF strips .html → e.g. /worldcup/app/leaderboard). The
# :page placeholder matches a SINGLE segment, so it covers every app page but
# NOT the deeper /worldcup/app/assets/* files (those stay cacheable via ?v=).
# Without this, clean URLs fell through to default caching → stale on mobile.
/worldcup/app/:page
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0
